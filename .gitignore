node_modules/
dist/
build/
.env
.env.local
*.log
.DS_Store
.vite/
coverage/
*.tsbuildinfo

# Never let tsc emit next to sources (Vite resolves .js before .tsx)
frontend/src/**/*.js
frontend/src/**/*.js.map
frontend/src/**/*.d.ts
!frontend/src/vite-env.d.ts

# Compiled output that shadows the TypeScript source. Vite resolves
# vite.config.js before vite.config.ts, so a stale one silently wins.
frontend/vite.config.js
shared/src/**/*.js
shared/src/**/*.js.map
