# ---- serverless functions (api/) ----
# Where enquiries are emailed. Both must be set in production or the function
# refuses the submission rather than silently dropping a patient's request.
SMTP_URL=
NOTIFY_EMAIL=frontdesk@drdivyafetalmedicine.com
# Optional. Defaults to NOTIFY_EMAIL. Must be an address your SMTP provider
# is allowed to send as, or messages will land in spam.
FROM_EMAIL=

# Example SMTP_URL formats (never commit real credentials):
#   smtps://user%40domain.com:app-password@smtp.gmail.com:465
#   smtp://apikey:SG.xxxxx@smtp.sendgrid.net:587

# ---- frontend (build-time, public) ----
# Anything prefixed VITE_ is embedded in the JS bundle and is PUBLIC.
# Never put a credential here.
VITE_GOOGLE_MAPS_EMBED_URL=
