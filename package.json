{
  "name": "drdivya-fetal-medicine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "frontend"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run build -w shared && npm run dev -w frontend",
    "build": "npm run build -w shared && npm run build -w frontend",
    "start": "tsx server/index.ts",
    "preview": "npm run preview -w frontend",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w frontend && tsc -p api/tsconfig.json"
  },
  "dependencies": {
    "@drdivya/shared": "*",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.3"
  }
}
